# ============================================================================
# laravel-rebel-bridge-passkeys — environment variables
# All optional: they have sensible defaults in config/rebel-bridge-passkeys.php.
# ============================================================================

# Enable or disable the WebAuthn/passkey step-up driver (AAL3, phishing-resistant).
# The driver is only registered when BOTH this is true AND a PasskeyChallenger
# implementation is bound in the service container.
REBEL_PASSKEYS_DRIVER_PASSKEYS=true
